  m_Script: {fileID: 11500000, guid: 4b50a855464146e98b1362ddb9326af0, type: 3}
  m_Name: Dialogue1
  m_EditorClassIdentifier: Assembly-CSharp::Game.Scripts.DialogueModule.DialogueData
  FullDialogue:
  - Dialogue: "\u041E\u0439, \u0431\u0430\u0442\u044E\u0448\u043A\u0438! \u041C\u043E\u043B\u043E\u0434\u0451\u0436\u044C
      \u043F\u0440\u0438\u0448\u043B\u0430! \u0410 \u0447\u0435\u0433\u043E\u0439
      \u0442\u044B \u0442\u0443\u0442, \u0434\u0435\u0432\u043E\u0447\u043A\u0430?
      \u0422\u043E\u0436\u0435 \u043A \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0430\u043C
      \u0435\u0434\u0435\u0448\u044C?"
    Speaker: {fileID: 9016322717536808786, guid: 6f2d97194d5cb244580d6f6acf1db02e, type: 3}
    SpeakerName: "\u0414\u0435\u0434"
  - Dialogue: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
      \u0410 \u0432\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435, \u0433\u0434\u0435
      \u043C\u044B?"
    Speaker: {fileID: 9016322717536808786, guid: 6f2d97194d5cb244580d6f6acf1db02e, type: 3}
    SpeakerName: ...
  - Dialogue: "\u041A\u0430\u043A \u044D\u0442\u043E \u0433\u0434\u0435? \u0412\u043E\u0442
      \u0441\u0442\u0430\u043D\u0438\u0446\u0443 \u0413\u0440\u0435\u0447\u0430\u043D\u0443\u044E
      \u043F\u0440\u043E\u0435\u0437\u0436\u0430\u0435\u043C! "
    Speaker: {fileID: 9016322717536808786, guid: 6f2d97194d5cb244580d6f6acf1db02e, type: 3}
    SpeakerName: "\u0414\u0435\u0434"
  - Dialogue: "\u0410 \u043C\u044B \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0435
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0438\u0441\u044C? \u0422\u044B
      \u043A\u043E\u0433\u043E-\u0442\u043E \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0448\u044C..."
    Speaker: {fileID: 9016322717536808786, guid: 6f2d97194d5cb244580d6f6acf1db02e, type: 3}
    SpeakerName: "\u0414\u0435\u0434"
  - Dialogue: "\u042F... \u041D\u0435 \u0434\u0443\u043C\u0430\u044E? \u042F \u043D\u0435
      \u0437\u043D\u0430\u044E..."
    Speaker: {fileID: 9016322717536808786, guid: 6f2d97194d5cb244580d6f6acf1db02e, type: 3}
    SpeakerName: ...
  - Dialogue: "\u041E\u0439 \u043C\u043E\u043B\u043E\u0434\u0451\u0436\u044C \u043F\u043E\u0448\u043B\u0430,
      \u043F\u0430\u043C\u044F\u0442\u044C \u043A\u0430\u043A \u0443 \u043C\u0435\u043D\u044F!"
    Speaker: {fileID: 9016322717536808786, guid: 6f2d97194d5cb244580d6f6acf1db02e, type: 3}
    SpeakerName: "\u0414\u0435\u0434"
  - Dialogue: ...
    Speaker: {fileID: 9016322717536808786, guid: 6f2d97194d5cb244580d6f6acf1db02e, type: 3}
    SpeakerName: ...
  - Dialogue: "\u0412\u044B \u0431\u043E\u043B\u0435\u0435\u0442\u0435? \u0422\u0430\u0431\u043B\u0435\u0442\u043A\u0438
      \u0442\u0443\u0442..."
    Speaker: {fileID: 9016322717536808786, guid: 6f2d97194d5cb244580d6f6acf1db02e, type: 3}
    SpeakerName: ...
  - Dialogue: "\u0412\u044B \u0431\u043E\u043B\u0435\u0435\u0442\u0435? \u0422\u0430\u0431\u043B\u0435\u0442\u043A\u0438
      \u0442\u0443\u0442..."
    Speaker: {fileID: 9016322717536808786, guid: 6f2d97194d5cb244580d6f6acf1db02e, type: 3}
    SpeakerName: ...
