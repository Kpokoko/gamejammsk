  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b50a855464146e98b1362ddb9326af0, type: 3}
  m_Name: Dialogue0
  m_EditorClassIdentifier: Assembly-CSharp::Game.Scripts.DialogueModule.DialogueData
  FullDialogue:
  - Dialogue: "\u041E\u0439? \u0427\u0442\u043E \u0442\u044B \u0442\u0443\u0442 \u0434\u0435\u043B\u0430\u0435\u0448\u044C
      \u0432 \u0442\u0430\u043A\u043E\u043C \u0432\u0438\u0434\u0435? \u041F\u043E\u0447\u0435\u043C\u0443
      \u0442\u044B \u043E\u0434\u043D\u0430?"
    Speaker: {fileID: -7215855398322179507, guid: 3835a86d7474c5a45842f757535cee86, type: 3}
    SpeakerName: ...
  - Dialogue: "\u041F\u0440\u0438\u0432\u0435\u0442! \u041D\u0435 \u0437\u043D\u0430\u044E,
      \u044F \u043D\u0435 \u043F\u043E\u043C\u043D\u044E"
    Speaker: {fileID: 5480356130980201124, guid: 46bcdcf0d92732a4a9b26d21ab6f6320, type: 3}
    SpeakerName: "\u0414\u0435\u0432\u043E\u0447\u043A\u0430"
  - Dialogue: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u043C\u043E\u043A\u0440\u0430\u044F?"
    Speaker: {fileID: -7215855398322179507, guid: 3835a86d7474c5a45842f757535cee86, type: 3}
    SpeakerName: ...
  - Dialogue: "\u041D\u0435 \u0437\u043D\u0430\u044E... \u042F \u043F\u043E\u0448\u043B\u0430
      \u0433\u0443\u043B\u044F\u0442\u044C \u0441 \u043F\u043E\u0434\u0440\u0443\u0436\u043A\u043E\u0439.
      \u041F\u043E\u043C\u043D\u044E, \u043A\u0430\u043A \u0443 \u043D\u0435\u0451
      \u043C\u0438\u0448\u043A\u0430 \u0443\u043F\u0430\u043B \u043D\u0430 \u043B\u0451\u0434!
      \u042F \u043F\u043E\u0431\u0435\u0436\u0430\u043B\u0430 \u0437\u0430 \u043D\u0438\u043C,
      \u0430 \u043F\u043E\u0442\u043E\u043C... \u041D\u0435 \u043F\u043E\u043C\u043D\u044E."
    Speaker: {fileID: 1748249971712418318, guid: aaa4f5cd69949b84ba0df116031b2961, type: 3}
    SpeakerName: "\u0414\u0435\u0432\u043E\u0447\u043A\u0430"
  - Dialogue: "\u0413\u0434\u0435 \u0442\u0432\u043E\u0438 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438?
      \u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0442\u0443\u0442?"
    Speaker: {fileID: -7215855398322179507, guid: 3835a86d7474c5a45842f757535cee86, type: 3}
    SpeakerName: ...
  - Dialogue: "\u041D\u0435 \u0437\u043D\u0430\u044E... \u041D\u043E \u043C\u0438\u0448\u043A\u0430
      \u0443 \u043C\u0435\u043D\u044F! \u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0443
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439, \u0430 \u0442\u044B
      \u043C\u043E\u0436\u0435\u0448\u044C \u043E\u0442\u0434\u0430\u0442\u044C \u0435\u0433\u043E
      \u043C\u043E\u0435\u0439 \u043F\u043E\u0434\u0440\u0443\u0436\u043A\u0435?
      \u0423 \u043D\u0435\u0451 \u0442\u0430\u043A\u0438\u0435 \u0436\u0435 \u043A\u0443\u0434\u0440\u044F\u0432\u044B\u0435
      \u0432\u043E\u043B\u043E\u0441\u044B, \u043A\u0430\u043A \u0443 \u0442\u0435\u0431\u044F!"
    Speaker: {fileID: 1748249971712418318, guid: aaa4f5cd69949b84ba0df116031b2961, type: 3}
    SpeakerName: "\u0414\u0435\u0432\u043E\u0447\u043A\u0430"
