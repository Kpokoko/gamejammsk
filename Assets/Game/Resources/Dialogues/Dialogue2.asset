  m_Script: {fileID: 11500000, guid: 4b50a855464146e98b1362ddb9326af0, type: 3}
  m_Name: Dialogue2
  m_EditorClassIdentifier: Assembly-CSharp::Game.Scripts.DialogueModule.DialogueData
  FullDialogue:
  - Dialogue: "\u0412\u043E\u0442 \u043C\u044B \u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438\u0441\u044C."
    Speaker: {fileID: -7900035720936464586, guid: f68683ae216a0c64893dcc5ea78af6ca, type: 3}
    SpeakerName: ...
  - Dialogue: ...
    Speaker: {fileID: 7229863764268736092, guid: 8afbe1a5ba758d54bbdd3e521bebce08, type: 3}
    SpeakerName: ...
  - Dialogue: "\u041C\u043E\u043B\u0447\u0438\u0448\u044C? \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
      \u043D\u0430\u0448\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0442\u044B
      \u0431\u044B\u043B\u0430 \u0441\u043C\u0435\u043B\u0435\u0435."
    Speaker: {fileID: -7900035720936464586, guid: f68683ae216a0c64893dcc5ea78af6ca, type: 3}
    SpeakerName: ...
  - Dialogue: "\u041C\u044B \u0437\u043D\u0430\u043A\u043E\u043C\u044B?"
    Speaker: {fileID: -7215855398322179507, guid: 3835a86d7474c5a45842f757535cee86, type: 3}
    SpeakerName: ...
  - Dialogue: "\u042F \u0442\u043E\u0442, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u043A\u043E\u043C\u0443 \u0442\u044B \u0437\u0434\u0435\u0441\u044C. \u0418
      \u0442\u044B \u0442\u0430, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u043A\u043E\u043C\u0443 \u042F \u0437\u0434\u0435\u0441\u044C."
    Speaker: {fileID: -7900035720936464586, guid: f68683ae216a0c64893dcc5ea78af6ca, type: 3}
    SpeakerName: ...
  - Dialogue: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C
      \u0437\u0430\u0433\u0430\u0434\u043A\u0430\u043C\u0438?"
    Speaker: {fileID: 7229863764268736092, guid: 8afbe1a5ba758d54bbdd3e521bebce08, type: 3}
    SpeakerName: ...
  - Dialogue: "\u041D\u0435 \u043F\u043E\u043C\u043D\u0438\u0448\u044C \u043C\u0435\u043D\u044F?
      \u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u043D\u0435\u0432\u0430\u0436\u043D\u043E.
      \u041E\u0442\u0441\u044E\u0434\u0430 \u043D\u0435\u0442 \u0432\u044B\u0445\u043E\u0434\u0430.
      \u041D\u0443, \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0448\u044C \u2014
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438."
    Speaker: {fileID: -7900035720936464586, guid: f68683ae216a0c64893dcc5ea78af6ca, type: 3}
    SpeakerName: ...
